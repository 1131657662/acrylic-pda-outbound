[Unit]
Description=Acrylic outbound isolated test background worker
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=acrylic-outbound-test
Group=acrylic-outbound-test
WorkingDirectory=/var/lib/acrylic-outbound-test
EnvironmentFile=/etc/acrylic-outbound-test/runtime.env
Environment=SPRING_PROFILES_ACTIVE=worker
Environment=OUTBOUND_MIGRATE=false
Environment=OUTBOUND_EXPORTS_RENDERER_HOME=/opt/acrylic-outbound-test/current/report-rendering/acrylic-report-rendering
Environment=OUTBOUND_EXPORTS_BROWSERS=/var/lib/acrylic-outbound-test/browsers
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/acrylic-outbound-test/browsers
ExecStart=/usr/bin/java -Duser.timezone=UTC -Xms64m -Xmx256m -jar /opt/acrylic-outbound-test/current/server.jar
Restart=on-failure
SuccessExitStatus=143
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
SendSIGKILL=yes
UMask=0077
MemoryHigh=1G
MemoryMax=2G
CPUQuota=50%
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/acrylic-outbound-test
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
