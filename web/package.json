{
  "name": "acrylic-outbound-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:pda-download": "npm run build && playwright test --config=pda-download.config.ts",
    "check:contract": "node tools/check-contract.mjs",
    "test:temporary-review": "node --experimental-strip-types --test tools/temporary-review.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.5",
    "pinia": "3.0.4",
    "qrcode": "1.5.4",
    "vue": "3.5.42",
    "vue-router": "4.6.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@playwright/test": "1.63.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
