<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pda_canvas">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置本人应急解锁" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="首次设置须联网登录。设备断网或登录过期时，用它取回本人原记录，不增加扫码或放行权限。遗失后须重新联网核验再设置，不能离线重置；请在设备外单独保管，并与文件解密口令分开。退出登录不会撤销此只读资格。" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置应急解锁口令" android:labelFor="@id/password" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="口令规则：16至128位无空格ASCII字符；不要使用人员姓名、简单序列或与导出文件共用口令。请在设备外独立保管。" android:textSize="14sp" />
        <Button android:id="@+id/provision" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="联网核验并保存解锁方式" />
        <Button android:id="@+id/revoke" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="撤销本人的应急解锁方式" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="返回" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
