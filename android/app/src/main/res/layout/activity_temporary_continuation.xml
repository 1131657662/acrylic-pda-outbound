<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/pda_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="返回" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="核验并恢复装车"
            android:textSize="22sp" android:textStyle="bold" android:textColor="@color/pda_text_primary" android:paddingTop="12dp" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="@color/pda_text_primary" android:paddingTop="16dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="@color/pda_text_primary" android:paddingTop="12dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/pda_text_primary" android:paddingTop="12dp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/confirm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="16dp" android:text="确认原计划并恢复装车" android:enabled="false" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="核对原请求结果" />
        <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="进入原作业" android:enabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"
            android:textSize="16sp" android:textColor="@color/pda_text_primary"
            android:text="原计划、保留包及停止记录持续保留。恢复装车不代表出库确认；上传并完成独立确认前，车辆不得放行。" />
    </LinearLayout>
</ScrollView>
