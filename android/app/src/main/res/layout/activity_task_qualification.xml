<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/pda_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="返回原页面" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="本单资料与资格" android:textSize="22sp" android:textStyle="bold"
            android:accessibilityHeading="true" android:textColor="@color/pda_text_primary" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="@color/pda_text_primary" android:paddingTop="12dp"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="重新只读核对" />
        <Button android:id="@+id/qualificationDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="展开原始原因" android:visibility="gone" />
        <TextView android:id="@+id/rawDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/pda_text_secondary" android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
