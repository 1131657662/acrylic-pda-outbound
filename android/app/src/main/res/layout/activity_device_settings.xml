<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/pda_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/back" style="@style/SettingsAction" android:text="返回" />
        <TextView style="@style/SettingsHeading" android:text="设备信息与设置" android:textSize="22sp" />
        <TextView style="@style/SettingsHeading" android:text="当前身份" />
        <TextView android:id="@+id/deviceName" style="@style/SettingsText" />
        <TextView android:id="@+id/identity" style="@style/SettingsText" />
        <TextView style="@style/SettingsHeading" android:text="作业偏好" />
        <Switch android:id="@+id/sound" style="@style/SettingsText" android:minHeight="52dp" android:text="声音提示" />
        <TextView style="@style/SettingsSecondary" android:text="成功声音以本机保存结果为准；静音时请核对屏幕上的保存反馈。" />
        <TextView style="@style/SettingsHeading" android:text="连接与更新" />
        <Button android:id="@+id/checkConnection" style="@style/SettingsAction" android:text="检查后台连接" />
        <TextView android:id="@+id/status" style="@style/SettingsText" android:text="正在读取本机身份" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/diagnosticDetailsToggle" style="@style/SettingsAction" android:text="展开原始详情" android:visibility="gone" />
        <TextView android:id="@+id/diagnosticDetails" style="@style/SettingsSecondary" android:visibility="gone" android:textIsSelectable="true" />
        <TextView android:id="@+id/syncStatus" style="@style/SettingsSecondary" />
        <Button android:id="@+id/appUpdate" style="@style/SettingsAction" android:text="应用更新" />
        <TextView style="@style/SettingsSecondary" android:text="检查更新不清理作业资料；安装前仍须满足原有安全条件。" />
        <TextView style="@style/SettingsHeading" android:text="身份维护" />
        <Button android:id="@+id/advanced" style="@style/SettingsAction" android:text="身份与版本详情" />
        <LinearLayout android:id="@+id/maintenance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/environment" style="@style/SettingsSecondary" />
            <TextView android:id="@+id/version" style="@style/SettingsSecondary" />
            <TextView android:id="@+id/server" style="@style/SettingsSecondary" />
            <TextView android:id="@+id/device" style="@style/SettingsSecondary" />
            <Button android:id="@+id/retryIdentity" style="@style/SettingsAction" android:text="重新读取本机信息" />
            <Button android:id="@+id/copyKey" style="@style/SettingsAction" android:text="复制本机登记公钥" />
            <LinearLayout android:id="@+id/bindFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="服务地址" android:labelFor="@id/serverInput" />
                <EditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:inputType="textUri" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="管理员提供的设备标识" android:labelFor="@id/deviceInput" />
                <EditText android:id="@+id/deviceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:inputType="textVisiblePassword" />
                <Button android:id="@+id/bind" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="保存设备绑定" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/logout" style="@style/SettingsAction" android:layout_marginTop="16dp" android:text="退出登录（资料保留）" />
    </LinearLayout>
</ScrollView>
