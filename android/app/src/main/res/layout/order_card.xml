<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"
    android:background="#FFFFFF" android:padding="12dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#19372E" />
    <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:paddingTop="8dp" />
    <Button android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" />
    <Button android:id="@+id/work" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
        android:text="@string/work_enter" android:visibility="gone" />
</LinearLayout>
