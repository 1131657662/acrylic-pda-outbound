<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="核对选中的主管签名原件，也可粘贴原件。读取文件尚未获得权限，点击核验后仍须验签及核对人员、设备和范围。新授权须由指定救援人在原设备联网预置；已预置授权的签名撤销可离线导入。原件中的公钥不能自行作为信任根。" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="主管签名原件" android:labelFor="@id/material" />
        <EditText android:id="@+id/material" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:maxLines="6" android:maxLength="131072" android:inputType="textMultiLine|textNoSuggestions" android:saveEnabled="false" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="为此主管授权设置应急解锁口令；仅导入撤销时留空" android:labelFor="@id/password" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:maxLength="128" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="口令规则：16至128位无空格ASCII字符；不要使用人员姓名、简单序列或与导出文件共用口令。请在设备外独立保管。" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
