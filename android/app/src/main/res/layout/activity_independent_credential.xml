<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true" android:background="@color/pda_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置独立采集身份"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/pda_text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"
            android:text="先以原人员在已登记设备联网登录，再预置独立采集解锁口令。新增采集期限最多48小时；重启、改时钟、退出登录或身份变化须重新联网核验。独立记录始终待对账，不代表库存可用、出库成功或可放行。" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/independentPasswordLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="独立采集解锁口令" android:textSize="16sp" android:labelFor="@id/password" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
            android:hint="输入独立采集口令" android:inputType="textPassword" android:maxLength="128"
            android:importantForAutofill="no" android:saveEnabled="false" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="口令规则：16至128位无空格ASCII字符；不要使用人员姓名、简单序列或与导出文件共用口令。请在设备外独立保管。" android:textSize="14sp" />
        <Button android:id="@+id/provision" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="联网核验并保存独立采集身份" />
        <Button android:id="@+id/verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="核验本机独立采集资格" />
        <Button android:id="@+id/reload" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="查看已保存的身份状态" />
        <TextView android:id="@+id/original" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textIsSelectable="true" />
        <Button android:id="@+id/revoke" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="撤销本机新增采集资格，保留原件" />
        <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="返回，保留资料" />
    </LinearLayout>
</ScrollView>
