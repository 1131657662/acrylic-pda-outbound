<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="52dp" android:text="返回（资料保留）" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="受控召回 · 原机停止" android:textSize="22sp" android:textStyle="bold" android:textColor="#19372E" android:paddingTop="12dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textSize="16sp" />
        <TextView android:id="@+id/reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textSize="16sp" />
        <TextView android:id="@+id/totals" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="待核对输入" android:textStyle="bold" android:paddingTop="18dp" />
        <TextView android:id="@+id/pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textSize="15sp" />
        <Button android:id="@+id/freeze" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="逐项核对并固定恢复包" android:layout_marginTop="18dp" />
        <Button android:id="@+id/upload" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="上传恢复包并确认停止" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="联网查询召回" />
        <Button android:id="@+id/continueWork" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="核验主管批准并恢复续作" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A52A2A" android:paddingTop="12dp" />
    </LinearLayout>
</ScrollView>
